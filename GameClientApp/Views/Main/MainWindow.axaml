<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vmusers="using:GameClientApp.ViewModels.Users"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewsusers="clr-namespace:GameClientApp.Views.Users"
        xmlns:views="clr-namespace:GameClientApp.Views"
        xmlns:main="clr-namespace:GameClientApp.ViewModels.Main"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GameClientApp.Views.MainWindow"
        x:DataType="main:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameClientApp">
    
    <Window.DataTemplates>
        <DataTemplate DataType="vmusers:SuperAdminViewModel">
            <viewsusers:SuperAdminView />
        </DataTemplate>
        <DataTemplate DataType="vmusers:AdminViewModel">
            <viewsusers:AdminView />
        </DataTemplate>
        <DataTemplate DataType="vmusers:DeveloperViewModel">
            <viewsusers:DeveloperView />
        </DataTemplate>
        <DataTemplate DataType="vmusers:ClientViewModel">
            <viewsusers:ClientView />
        </DataTemplate>
    </Window.DataTemplates>
    
    <DockPanel>
        <views:CustomTitleBar DockPanel.Dock="Top" />
        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>

    

</Window>
