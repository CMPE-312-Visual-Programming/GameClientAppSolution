<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameClientApp.ViewModels.Login"
             x:Class="GameClientApp.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <StackPanel Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Register" FontSize="20" FontWeight="Bold" />
        <TextBox Watermark="Username" Text="{Binding Username}" />
        <TextBox Watermark="Password" PasswordChar="*" Text="{Binding Password}" />
        
        <Button Content="Register" Command="{Binding RegisterCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Back to Login" Command="{Binding BackToLoginCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>