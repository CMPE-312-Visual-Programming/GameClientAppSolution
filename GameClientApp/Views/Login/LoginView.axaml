<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameClientApp.ViewModels.Login"
             xmlns:login="clr-namespace:GameClientApp.ViewModels.Login"
             x:Class="GameClientApp.Views.LoginView"
             x:DataType="login:LoginViewModel">

    <StackPanel Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Login" FontSize="20" FontWeight="Bold" />
        <TextBox Watermark="Username" Text="{Binding Username}" />
        <TextBox Watermark="Password" PasswordChar="*" Text="{Binding Password}" />
        
        <Button Content="Login" Command="{Binding LoginCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Register" Command="{Binding GoToRegisterCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>