<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GameClientApp.Views.CustomTitleBar">
    <Border Classes="topBar" PointerPressed="OnTitleBarPointerPressed">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="—" Classes="windowButtons" Click="OnMinimizeClick" />
                <Button Content="☐" Classes="windowButtons" Click="OnMaximizeClick" />
                <Button Content="✕" Classes="windowButtons" Click="OnCloseClick" />
            </StackPanel>
            <TextBlock Text="GameClientApp"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       Foreground="White" />
        </DockPanel>
    </Border>
</UserControl>
